  {
    "id": "fn_preparar_insert",
    "type": "function",
    "z": "flow_suelo",
    "name": "Validar y preparar INSERT",
    "func": "// Validar humedad antes de guardar\nconst h = Number(msg.payload && msg.payload.humedad);\n\nif (!Number.isFinite(h) || h < 0 || h > 100) {\n    node.warn(\"Humedad inválida: \" + (msg.payload && msg.payload.humedad));\n    return null;\n}\n\nmsg.query = 'INSERT INTO humedad (humedad, \"timestamp\") VALUES ($1, NOW());';\nmsg.params = [h];\nmsg.topic = \"humedad\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 100,
    "wires": [
      [
        "pg_insert"
      ]
    ]
  },
